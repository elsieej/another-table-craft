{
  "name": "another-table-craft-monorepo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/table-craft",
    "dev": "npm run dev --workspace=packages/table-craft",
    "typecheck": "npm run typecheck --workspace=packages/table-craft && npm run build --workspace=packages/table-craft && npm run typecheck --workspace=website",
    "lint": "eslint packages/table-craft/src website/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace=packages/table-craft",
    "test:watch": "npm run test:watch --workspace=packages/table-craft",
    "test:coverage": "npm run test:coverage --workspace=packages/table-craft",
    "clean": "npm run clean --workspace=packages/table-craft",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build --workspace=packages/table-craft && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elsieej/another-table-craft.git"
  }
}
